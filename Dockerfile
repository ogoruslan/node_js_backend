# 1. Беремо офіційний базовий образ
FROM node:lts

# 2. Створюємо робочу папку в контейнері
WORKDIR /app

# 3. Копіюємо файли залежностей та встановлюємо їх
COPY package*.json ./
RUN npm install

# 4. Копіюємо весь інший код застосунку
COPY . .

# 5. Вказуємо порт, який використовує застосунок
EXPOSE 3000

# 6. Команда для старту нашого сервера
CMD ["node", "src/server.js"]
